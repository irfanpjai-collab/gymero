{
  "name": "greenpower-crm",
  "productName": "Green Power CRM",
  "version": "1.0.0",
  "description": "Green Power Gym CRM — desktop launcher",
  "main": "main.js",
  "scripts": {
    "dev":   "electron .",
    "build": "node build.js && electron-builder --win --x64"
  },
  "devDependencies": {
    "electron":         "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId":       "com.greenpowergym.crm",
    "productName": "Green Power CRM",
    "copyright":   "Copyright © 2025 Green Power Gym",
    "directories": {
      "buildResources": "assets",
      "output":         "../dist"
    },
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon":   "assets/icon.png"
    },
    "nsis": {
      "oneClick":               true,
      "perMachine":             false,
      "createDesktopShortcut":  true,
      "createStartMenuShortcut":true,
      "shortcutName":           "Green Power CRM",
      "runAfterFinish":         true
    },
    "files": [
      "main.js",
      "settings.html"
    ],
    "extraResources": [
      { "from": "assets/icon.png", "to": "icon.png"           },
      { "from": "build/crm",       "to": "crm",    "filter": ["**/*"] },
      { "from": "bridge",          "to": "bridge", "filter": ["**/*"] }
    ]
  }
}
