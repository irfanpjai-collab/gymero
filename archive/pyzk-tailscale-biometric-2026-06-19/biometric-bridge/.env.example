# ── ZKTeco / ESSL Device ─────────────────────────────────────────────────────
# IP address of the fingerprint device on the local network
DEVICE_HOST=192.168.1.201
DEVICE_PORT=4370

# ── CRM Supabase ──────────────────────────────────────────────────────────────
CRM_SUPABASE_URL=
# Service-role key (NOT the anon key) — RLS requires a logged-in app user, which
# the bridge doesn't have. Supabase dashboard → Settings → API → service_role.
CRM_SUPABASE_SERVICE_KEY=

# ── Server ────────────────────────────────────────────────────────────────────
HOST=127.0.0.1
PORT=8000

# ── Bridge authentication ────────────────────────────────────────────────────
# BRIDGE_API_KEY guards every state-changing/sensitive endpoint (sent as the
# X-Bridge-Key header). BRIDGE_STREAM_KEY is a separate, lower-privilege key
# used only by the read-only /api/biometric/live SSE feed (sent as ?key=...,
# since browsers' native EventSource can't set custom headers) — keep it
# distinct so leaking it doesn't expose unlock/delete/push endpoints.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_API_KEY=
BRIDGE_STREAM_KEY=

# Comma-separated list of origins allowed to call this bridge from the browser.
BRIDGE_ALLOWED_ORIGINS=http://localhost:3000
